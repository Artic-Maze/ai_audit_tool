generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Audit {
  id        String   @id @default(cuid())
  domain    String
  status    String // queued | crawling | analyzing | done | failed
  stage     String? // finer-grained step for the progress UI (lib/jobs/stages.js)
  progress  Int      @default(0)
  error     String?
  snapshot  Json?
  report    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([domain, createdAt])
}

// Emails from the old email gate, which asked for one to unlock the full
// report. Nothing writes here anymore; the table is kept so collected
// emails aren't lost. Export them before dropping it in a migration.
model Lead {
  id        String   @id @default(cuid())
  email     String
  auditId   String
  createdAt DateTime @default(now())
}
