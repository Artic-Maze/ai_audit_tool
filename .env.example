# Copy to .env and fill in.

# Claude API — writes the opportunity explanations, copy rewrites and summary.
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-sonnet-5-5).
# ANTHROPIC_MODEL=

# Google PageSpeed Insights API v5.
PAGESPEED_API_KEY=

# Postgres. The database is created on the first `npm run db:migrate`.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_audit_tool?schema=public"

# Public URL of this app. Added to the crawler's User-Agent so store owners can
# see who is visiting.
APP_URL="http://localhost:3000"

# "Book a call" link at the end of each report. The section is hidden if unset.
BOOKING_URL=
