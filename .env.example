# Copy to .env and fill in.

# Claude API — used for opportunity ranking, copy rewrites and the summary.
ANTHROPIC_API_KEY=

# Google PageSpeed Insights API v5.
PAGESPEED_API_KEY=

# Postgres. The database is created on the first `npm run db:migrate`.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_audit_tool?schema=public"

# Public base URL — used for the PDF renderer and links in reports.
APP_URL="http://localhost:3000"
